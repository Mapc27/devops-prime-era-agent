@startuml c4-6-dynamic
!include <C4/C4_Dynamic>
LAYOUT_LEFT_RIGHT()
title C4 Dynamic · Расследование инцидента по алерту
Container(am, "Alertmanager")
Container(api, "Agent API")
Component(triage, "Triage (Jev-like)")
Component(know, "Knowledge")
Component(sup, "Supervisor")
Component(inv, "Investigator")
Component(val, "Validator (gemma)")
Component(rem, "Remediator")
Component(hitl, "Human gate")
Container(mcp, "ops-tools MCP")
Component(scr, "Scribe")
Rel(am, api, "1. webhook firing alert")
Rel(api, triage, "2. classify: incident, severity, skill")
Rel(triage, know, "3. recall similar incidents + facts")
Rel(know, sup, "4. plan hypotheses")
Rel(sup, inv, "5. investigate")
Rel(inv, mcp, "6. read-only tools → evidence E1..En")
Rel(sup, val, "7. diagnosis + evidence ids")
Rel(val, sup, "7a. revise (≤2)")
Rel(val, rem, "8. approve → choose action")
Rel(rem, val, "9. safety/fit validation")
Rel(val, hitl, "10. approval request")
Rel(hitl, mcp, "11. apply_remediation(token)")
Rel(mcp, scr, "12. verify recovery → postmortem → memory")
@enduml
