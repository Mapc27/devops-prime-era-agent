   "id": 40,
   "type": "row",
   "title": "Golden signals",
   "gridPos": {
    "w": 24,
    "h": 1,
    "x": 0,
    "y": 0
   },
   "collapsed": false
  },
  {
   "id": 30,
   "type": "timeseries",
   "title": "Requests/s by status",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(http_requests_total[1m]))",
     "legendFormat": "{{status}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "gridPos": {
    "w": 8,
    "h": 7,
    "x": 0,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 31,
   "type": "timeseries",
   "title": "5xx ratio",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_requests_total{status=~\"5..\"}[1m])) / clamp_min(sum(rate(http_requests_total[1m])), 0.001)",
     "legendFormat": null,
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "gridPos": {
    "w": 8,
    "h": 7,
    "x": 8,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 32,
   "type": "timeseries",
   "title": "/cart p95 latency",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/cart\"}[1m])))",
     "legendFormat": null,
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "gridPos": {
    "w": 8,
    "h": 7,
